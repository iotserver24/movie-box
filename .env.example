# Default binds only to this computer. Use a private LAN/VPN address for Android access.
SCRAPER_BIND=127.0.0.1
# Set a strong random token before exposing the API beyond localhost.
SCRAPER_API_TOKEN=
# Optional HTTP(S) proxy URL in the desired region (for example, a US egress proxy).
# The upstream chooses home content from the scraper's public IP; headers cannot override it.
SCRAPER_UPSTREAM_PROXY=
